# Import the time library to handle delays and interval pauses between commands
import time
# Import the datetime library to read and format highly accurate timestamps
from datetime import datetime
# Import the serial library to handle native hardware communication ports
import serial
# Import the serial tools package to query and list connected USB devices
import serial.tools.list_ports

# Define a static global target; 'AUTO' triggers the system to scan for the port
PORT_TARGET = "AUTO"
# Set the baud rate (speed) to 9600 bits per second to match the EBC-A20 firmware
BAUD_RATE = 9600
# Set the communication timeout window to 2 seconds before the script gives up
TIMEOUT_SEC = 2

# Define a specialized function to locate the physical USB-to-TTL serial link
def find_serial_port():
    # Execute a search loop iterating over all active comports found on macOS
    for p in list(serial.tools.list_ports.comports()):
        # Check if 'usbserial' or the CH340 chip's hex Vendor ID '1a86' is in the hardware description
        if "usbserial" in p.device.lower() or "1a86" in str(p.hwid).lower():
            # If a matching string is successfully detected, return the direct file path
            return p.device
    # If the system loops through all active ports and finds nothing, return a blank reference
    return None

# Initialize the main orchestrator block where execution begins
def main():
    # Create a local variable matching our target setting configuration
    port = PORT_TARGET
    
    # Check if the configuration profile is set to look for the hardware automatically
    if port == "AUTO":
        # Call our custom matching function to scan the operating system's device map
        detected_port = find_serial_port()
        # Evaluate if a valid physical device string was successfully discovered
        if detected_port:
            # Assign the discovered physical hardware address to our active port variable
            port = detected_port
            # Output an entry to confirm the location of the hardware interface link
            print(f"[+] Found device interface: {port}", flush=True)
        # Execute an emergency fallback sequence if no hardware address was returned
        else:
            # Output an explicit failure alert to notify that the cable cannot be seen
            print("[-] Error: Could not detect the USB cable.", flush=True)
            # Stop the execution of the function immediately to prevent an absolute system crash
            return

    # Initialize a safety monitoring try-except block to trap hardware configuration errors
    try:
        # Instaniate a persistent hardware serial object and open the link using specific parameters
        ser = serial.Serial(
            port=port,                     # Pass the absolute path to the physical USB adapter channel
            baudrate=BAUD_RATE,           # Apply our targeted transmission speed index
            bytesize=serial.EIGHTBITS,     # Configure data framing to process bits in chunks of 8
            parity=serial.PARITY_ODD,      # Force ZKETECH's required strict odd parity check flag
            stopbits=serial.STOPBITS_ONE,  # Terminate every data packet byte with exactly one stop bit boundary
            timeout=TIMEOUT_SEC            # Apply our time safety net parameter limit
        )
    # Define the exception handling pattern if the operating system reports the line is locked
    except Exception as e:
        # Output the exact systemic reason why the hardware gateway refused to open
        print(f"[-] Failed to open serial gateway: {str(e)}", flush=True)
        # Terminate the script cleanly since it cannot run without a valid physical stream
        return

    # Print a decorative structural separator block to clean up the terminal view
    print("\n" + "="*50, flush=True)
    # Output a specialized heading notifying that the raw telemetry monitor is alive
    print(" 🔍 RAW PACKET DIAGNOSTICS ACTIVE", flush=True)
    # Close out the decorative text separation block cleanly
    print("="*50, flush=True)

    # Initialize an infinite operational tracking loop to query the battery tester continuously
    try:
        # Begin the execution cycle that will repeat until a user manual stop is registered
        while True:
            # Define the exact 9-byte hexadecimal control packet array expected by ZKETECH instruments
            # '\xfa\x05' queries status parameter packets from the main hardware brain
            query_packet = b'\xfa\x05\x00\x00\x00\x00\x00\x00\xff'
            
            # Send the binary control packet down the USB wire directly into the EBC-A20 motherboard
            ser.write(query_packet)
            
            # Read up to 30 raw data bytes coming back over the transmission line buffer
            raw_buffer = ser.read(30)
            
            # Read the computer's internal clock and format it as a human-readable calendar metric
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            
            # Check if any physical binary frames cleared the wire buffer during the timeout slot
            if raw_buffer:
                # Convert the raw binary array into a continuous string of human-readable hex pairs
                hex_string = " ".join(f"{b:02x}" for b in raw_buffer)
                # Count the total number of bytes captured and print the clean string to the tracking terminal
                # flush=True overrides the operating system's buffer to force instant display rendering
                print(f"[{timestamp}] Raw Bytes ({len(raw_buffer)}): {hex_string}", flush=True)
            # Execute an alert response pattern if the device returned completely empty buffer sectors
            else:
                # Output a dedicated warning indicating that the connection loop is totally blank
                print(f"[{timestamp}] [-] No data frame received. Check physical cable.", flush=True)
                
            # Rest the CPU processing loop for exactly 1 second before requesting the next telemetry frame
            time.sleep(1)
            
    # Define what the script should do if you press the manual terminal cancel combination (Ctrl+C)
    except KeyboardInterrupt:
        # Output a clean status notification indicating the process was intentionally terminated
        print("\n[+] Exiting diagnostics monitor.", flush=True)
    # Initialize the guaranteed cleanup routine that runs no matter how the loop exited
    finally:
        # Close the hardware connection loop to release the device handle back to the operating system
        ser.close()

# Evaluate if this specific script file is being run directly as the primary executable target
if __name__ == "__main__":
    # Fire up the main tracking workflow loop immediately
    main()
        print("\n" + "=" * 50)
        print(" 🔋 BESS LAB LIVE MONITORING ENGAGED")
        print("=" * 50)

        try:
            while True:
                # Send the standard hex polling command packet to the tester
                # \xfa is the common ZKETECH initialization header
                ser.write(b"\xfa\x05\x00\x00\x00\x00\x00\x00\xff")

                # Listen for the incoming telemetry response frame
                response = ser.read(19)

